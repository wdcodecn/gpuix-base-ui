{
  "name": "gpuix-base-ui",
  "version": "0.1.0",
  "description": "Open-code, composable UI components for React on GPUIX.",
  "type": "module",
  "license": "MIT",
  "keywords": ["gpuix", "react", "ui", "base-ui", "desktop", "components"],
  "files": ["src", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./theme-context": {
      "types": "./src/theme-context.tsx",
      "import": "./src/theme-context.tsx"
    },
    "./components": {
      "types": "./src/components.tsx",
      "import": "./src/components.tsx"
    },
    "./base-components": {
      "types": "./src/base-components.tsx",
      "import": "./src/base-components.tsx"
    },
    "./list-impl": {
      "types": "./src/list-impl.tsx",
      "import": "./src/list-impl.tsx"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  },
  "scripts": {
    "dev": "bun --hot playground.tsx",
    "build": "bun build --compile playground.tsx --outfile dist/gpuix-base-ui-playground",
    "typecheck": "tsc --noEmit",
    "android:build": "bash android/scripts/build-android.sh",
    "android:install": "bash android/scripts/install-android.sh"
  },
  "dependencies": {
    "@gpuix/native": "0.9.0",
    "@gpuix/react": "0.9.0",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.3.0"
  }
}
