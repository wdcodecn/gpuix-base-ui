{
  "name": "gpuix-base-ui",
  "version": "0.1.0",
  "packageManager": "bun@1.4.5",
  "description": "Open-code, composable UI components for React on GPUIX.",
  "type": "module",
  "license": "MIT",
  "keywords": ["gpuix", "react", "ui", "base-ui", "desktop", "components"],
  "files": [
    "src",
    "README.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./theme-context": {
      "types": "./src/theme-context.tsx",
      "import": "./src/theme-context.tsx"
    },
    "./components": {
      "types": "./src/components.tsx",
      "import": "./src/components.tsx"
    },
    "./base-components": {
      "types": "./src/base-components.tsx",
      "import": "./src/base-components.tsx"
    },
    "./list-impl": {
      "types": "./src/list-impl.tsx",
      "import": "./src/list-impl.tsx"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  },
  "scripts": {
    "dev": "bun --hot playground.tsx",
    "build": "bun build --compile playground.tsx --outfile dist/gpuix-base-ui-playground",
    "lint": "oxlint --deny-warnings playground.tsx gallery.tsx native-demo.tsx src tests",
    "typecheck": "tsc --noEmit",
    "typecheck:tsrs": "tsrs --noEmit",
    "test": "bun test",
    "check": "bun run lint --type-aware --type-check && bun run typecheck"
  },
  "dependencies": {
    "@gpuix/native": "0.11.0",
    "@gpuix/react": "0.11.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "@types/react": "19.3.0",
    "oxlint": "1.95.0",
    "tsrs": "7.1.0-beta.tsrs4",
    "typescript": "7.0.2"
  }
}
